{
  "name": "@treeseed/platform",
  "version": "0.2.0-rc.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@treeseed/sdk": "0.13.0-rc.59",
    "yaml": "2.9.0"
  },
  "scripts": {
	"capacity-provider:sync": "node scripts/synchronize-capacity-provider-manifests.mjs",
	"capacity-provider:check": "node scripts/synchronize-capacity-provider-manifests.mjs --check",
	"guarantees:plan": "node scripts/plan-composition-guarantees.mjs",
	"guarantees:run": "node scripts/run-composition-guarantees.mjs",
	"test:guarantee-plan": "node scripts/test-composition-guarantee-plan.mjs",
	"test:guarantee-run": "node scripts/test-composition-guarantee-run.mjs",
    "verify:development": "node --import ./packages/cli/node_modules/tsx/dist/loader.mjs scripts/verify-development-workflow.ts",
    "verify": "npm run capacity-provider:check && node scripts/verify-platform.mjs",
    "verify:local": "npm run capacity-provider:check && node scripts/verify-platform.mjs"
  }
}
