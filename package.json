{
  "name": "@treeseed-cordis/platform-verification",
  "private": true,
  "type": "module",
  "scripts": {
    "check:installed": "tsc --strict --noEmit --allowImportingTsExtensions --module nodenext --target es2022 --skipLibCheck --types node,bun tests/acceptance/installed-composition.test.ts tests/regression/qualified-fixture-lock.test.ts",
    "test:installed": "bun run check:installed && bun test tests/acceptance/installed-composition.test.ts --timeout 900000",
    "prepare:ui": "bun tests/support/assembly/prepare-presentation.mts",
    "test:extensible": "bun test tests/acceptance/plugin-activation.test.mts",
    "test:ui": "bun test tests/acceptance/reusable-presentation.test.mts",
    "test:migration": "bun tests/support/assembly/installed-state-migration-program.mts",
    "check:test-layout": "bun .agents/skills/release-workflow/scripts/test-layout.ts",
    "check:composition": "tests/support/assembly/node_modules/.bin/tsc --strict --noEmit --allowImportingTsExtensions --module nodenext --target es2022 --skipLibCheck --types node,bun --typeRoots tests/support/assembly/node_modules/@types tests/support/assembly/*.mts tests/acceptance/plugin-activation.test.mts tests/acceptance/reusable-presentation.test.mts tests/regression/assembly-selection.test.mts",
    "test:acceptance": "bun run test:installed && bun run test:extensible && bun run prepare:ui && bun run test:ui && bun test tests/acceptance/source-readability.test.mts",
    "test:regression": "node --test tests/regression/retired-studio.test.mts tests/regression/authoring-policy.test.mts tests/regression/github-policy.test.mts tests/regression/package-composition.test.mts && bun test tests/regression/qualified-fixture-lock.test.ts tests/regression/test-layout.test.mts tests/regression/assembly-selection.test.mts tests/regression/presentation-cleanup.test.mts tests/regression/presentation-readback.test.mts",
    "test:integration": "node --test tests/integration/*.test.mts",
    "test:unit": "node --test tests/unit/*.test.mts",
    "check:readability": "bun .agents/skills/release-workflow/scripts/source-readability.ts",
    "check": "bun run check:test-layout && bun run check:readability",
    "test:artifact-diagnostics": "bun test tests/acceptance/artifact-diagnostics.test.mts"
  },
  "devDependencies": {
    "@treeseed-cordis/sdk": "file:packages/cli/vendor/sdk.tgz",
    "@treeseed-cordis/deployment": "file:packages/cli/vendor/deployment.tgz",
    "@treeseed-cordis/api": "file:vendor/task3b/api.tgz",
    "@treeseed-cordis/identity": "file:vendor/task3b/identity.tgz",
    "@treeseed-cordis/admin": "file:vendor/task3b/admin.tgz",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "@types/bun": "1.4.4",
    "@types/node": "24.10.1",
    "prettier": "3.6.2"
  }
}
