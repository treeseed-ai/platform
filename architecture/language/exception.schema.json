{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:treeseed:architecture-exception:0.1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "architecture-exception/0.1"
    },
    "rule": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reason": {
      "type": "string"
    },
    "owningIssue": {
      "type": "string"
    },
    "reviewCondition": {
      "type": "string"
    },
    "status": {
      "enum": [
        "historical-debt",
        "accepted-exception"
      ]
    },
    "expected": {
      "type": "string"
    },
    "sourceBinding": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^/]+(?:/[^/]+)*$"
        },
        "symbol": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "project",
        "revision",
        "path"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "rule",
    "subject",
    "symbol",
    "fingerprint",
    "reason",
    "owningIssue",
    "reviewCondition",
    "status"
  ],
  "additionalProperties": false
}
