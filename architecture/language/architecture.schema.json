{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:treeseed:architecture:0.1",
  "title": "Architectural blueprint 0.1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "architecture/0.1"
    },
    "view": {
      "enum": [
        "implementation",
        "intent",
        "example",
        "profile"
      ]
    },
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "required": [
    "schemaVersion",
    "view",
    "project",
    "objects",
    "metadata"
  ],
  "additionalProperties": false,
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*:[A-Za-z0-9._-]+$": {
          "$ref": "#/$defs/json"
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^/]+(?:/[^/]+)*$"
        },
        "symbol": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "project",
        "revision",
        "path"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "subject": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "method": {
          "enum": [
            "source",
            "schema",
            "runtime",
            "review"
          ]
        },
        "status": {
          "enum": [
            "satisfied",
            "violated",
            "unknown"
          ]
        },
        "project": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "statement": {
          "type": "string"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "assertion": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "stale": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "subject",
        "method",
        "status",
        "project",
        "revision",
        "statement"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "runtime"
              }
            }
          },
          "then": {
            "required": [
              "assertion",
              "artifact"
            ]
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "proposed",
            "accepted",
            "mixed",
            "illustrative"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "acceptedSubjects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "baseline",
        "status",
        "notes"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "parent": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "lifetime": {
          "type": "string"
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          },
          "uniqueItems": true
        },
        "fixedBindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capability": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
              },
              "component": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
              }
            },
            "required": [
              "capability",
              "component"
            ],
            "additionalProperties": false
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "lifetime"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "capability": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "provider": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        }
      },
      "required": [
        "scope",
        "capability",
        "provider"
      ],
      "additionalProperties": false
    },
    "replacement": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "live",
            "restart",
            "migration"
          ]
        },
        "qualification": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "stateVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "kind": {
          "enum": [
            "entry",
            "call",
            "message",
            "branch",
            "parallel",
            "join",
            "repeat",
            "cancel",
            "failure",
            "cleanup",
            "complete"
          ]
        },
        "participant": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "contract": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "predicate": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "next": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          }
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          }
        },
        "join": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "bound": {
          "type": "integer",
          "minimum": 1
        },
        "exhausted": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "description": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "description"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "repeat"
              }
            }
          },
          "then": {
            "required": [
              "bound",
              "exhausted",
              "body"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "call",
                  "message"
                ]
              }
            }
          },
          "then": {
            "required": [
              "participant",
              "contract"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "parallel"
              }
            }
          },
          "then": {
            "required": [
              "branches",
              "join"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "join"
              }
            }
          },
          "then": {
            "required": [
              "branches"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "branch"
              }
            }
          },
          "then": {
            "required": [
              "predicate",
              "outcomes"
            ]
          }
        },
        {
          "not": {
            "required": [
              "next",
              "outcomes"
            ]
          }
        }
      ]
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "kind": {
          "const": "project"
        },
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "sourceBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "repository": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "language": {
          "enum": [
            "typescript",
            "tsx",
            "elixir",
            "rust",
            "mixed"
          ]
        },
        "external": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "purpose",
        "repository"
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "kind": {
          "const": "component"
        },
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "sourceBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "project": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "componentKind": {
          "enum": [
            "object",
            "plugin"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          }
        },
        "runtime": {
          "type": "string"
        },
        "ownedFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^/]+(?:/[^/]+)*$"
          }
        },
        "componentRole": {
          "enum": [
            "runtime",
            "logical-area",
            "contract",
            "data",
            "internal-helper",
            "development-policy"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "purpose",
        "project",
        "componentKind"
      ],
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "kind": {
          "const": "capability"
        },
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "sourceBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "contract": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "cardinality": {
          "enum": [
            "singleton",
            "collection"
          ]
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "implementationMode": {
          "enum": [
            "fixed",
            "selectable"
          ]
        },
        "coherentInvariant": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "purpose",
        "contract",
        "cardinality"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "implementationMode"
            ],
            "properties": {
              "implementationMode": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "required": [
              "coherentInvariant"
            ]
          }
        }
      ]
    },
    "contract": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "kind": {
          "const": "contract"
        },
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "sourceBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "project": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "version": {
          "type": "string"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "schemaRef": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "purpose",
        "project",
        "version"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "kind": {
          "const": "provider"
        },
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "sourceBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "component": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          }
        },
        "contractVersion": {
          "type": "string"
        },
        "nativeId": {
          "type": "string"
        },
        "configurationSchema": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "replacement": {
          "$ref": "#/$defs/replacement"
        },
        "target": {
          "type": "string"
        },
        "contract": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "purpose",
        "component",
        "capabilities",
        "contractVersion"
      ],
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "kind": {
          "const": "composition"
        },
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "sourceBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "project": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "target": {
          "type": "string"
        },
        "process": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope"
          }
        },
        "registrations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          }
        },
        "selections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selection"
          }
        },
        "readiness": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "purpose",
        "project",
        "target",
        "process",
        "scopes"
      ],
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "kind": {
          "const": "flow"
        },
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "sourceBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          }
        },
        "entry": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
        },
        "predicates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
              },
              "description": {
                "type": "string"
              },
              "sourceBindings": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/binding"
                }
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "nodes": {
          "type": "array",
          "items": {
