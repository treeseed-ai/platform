{
  "name": "@treeseed/architecture-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/server/main.ts --dev",
    "build": "tsc --noEmit && vite build && esbuild src/server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "check": "tsc --noEmit && tsx scripts/policy.ts",
    "test": "tsx scripts/tests.ts",
    "test:unit": "tsx scripts/tests.ts unit",
    "test:integration": "tsx scripts/tests.ts integration",
    "test:acceptance": "tsx scripts/tests.ts acceptance"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "ajv": "8.20.0",
    "cordis": "4.0.0-rc.12",
    "elkjs": "0.12.1",
    "monaco-editor": "0.57.0",
    "prettier": "3.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "vite": "8.3.5"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
