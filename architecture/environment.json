{
  "schemaVersion": 1,
  "prerequisites": [
    {
      "command": "node",
      "args": [
        "-e",
        "if(process.versions.node!=='24.19.0')process.exit(2)"
      ]
    },
    {
      "command": "bun",
      "args": [
        "--version"
      ]
    }
  ],
  "setup": [
    {
      "command": "bun",
      "args": [
        "install",
        "--frozen-lockfile",
        "--ignore-scripts",
        "--cache-dir",
        ".qualification/cache/root"
      ]
    },
    {
      "command": "bun",
      "args": [
        "install",
        "--cwd",
        "tests/support/assembly",
        "--frozen-lockfile",
        "--ignore-scripts",
        "--cache-dir",
        ".qualification/cache/assembly"
      ]
    }
  ],
  "generatedDirectories": [
